  "tier1": {
    "_comment": "Continuous. Macro knobs (dashboard links) are the preferred AI surface: Gil maps them inside Arena to whatever he wants moved.",
    "rules": [
      {
        "pattern": "/composition/dashboard/link7",
        "kind": "float",
        "range": [
          0,
          1
        ],
        "max_value": 0.15,
        "min_interval_s": 0.2,
        "max_step": 0.01,
        "verified": true
      },
      {
        "pattern": "/composition/dashboard/link5",
        "kind": "float",
        "range": [
          0,
          1
        ],
        "max_value": 0.45,
        "min_interval_s": 0.2,
        "max_step": 0.01,
        "verified": true
      },
      {
        "pattern": "/composition/dashboard/link2",
        "kind": "float",
        "range": [
          0,
          1
        ],
        "min_interval_s": 0.2,
        "max_step": 0.01,
        "verified": true
      },
      {
        "pattern": "/composition/layers/*/dashboard/link{1,2,3,4,5,6,7,8}",
